#include <stdio.h>

int fatorial(int n) {
    int f = 1;
    for (int i = 2; i <= n; i++)
        f = f * i;
    return f;
}

int arranjo(int n, int p) {
    return fatorial(n) / fatorial(n - p);
}

int permutacao(int n) {
    return fatorial(n);
}

int combinacao(int n, int p) {
    return fatorial(n) / (fatorial(p) * fatorial(n - p));
}

void trianguloPascal(int linhas) {
    int i, j, e;
    for (i = 0; i < linhas; i++) {
        for (e = 0; e < linhas - i - 1; e++)
            printf("  ");
        for (j = 0; j <= i; j++)
            printf("%4d", combinacao(i, j));
        printf("\n");
    }
}

int main() {
    int opcao, n, p;

    do {
        printf("\n===== MENU =====\n");
        printf("1 - Triangulo de Pascal\n");
        printf("2 - Arranjo\n");
        printf("3 - Permutacao simples\n");
        printf("4 - Combinacao\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Numero de linhas (1 a 12): ");
                scanf("%d", &n);
                if (n < 1 || n > 12)
                    printf("Valor invalido.\n");
                else
                    trianguloPascal(n);
                break;

            case 2:
                printf("Digite n: ");
                scanf("%d", &n);
                printf("Digite p: ");
                scanf("%d", &p);
                if (n < 0 || p < 0 || p > n || n > 12)
                    printf("Valores invalidos (0 <= p <= n <= 12).\n");
                else
                    printf("A(%d,%d) = %d\n", n, p, arranjo(n, p));
                break;

            case 3:
                printf("Digite n: ");
                scanf("%d", &n);
                if (n < 0 || n > 12)
                    printf("Valor invalido (0 a 12).\n");
                else
                    printf("P(%d) = %d\n", n, permutacao(n));
                break;

            case 4:
                printf("Digite n: ");
                scanf("%d", &n);
                printf("Digite p: ");
                scanf("%d", &p);
                if (n < 0 || p < 0 || p > n || n > 12)
                    printf("Valores invalidos (0 <= p <= n <= 12).\n");
                else
                    printf("C(%d,%d) = %d\n", n, p, combinacao(n, p));
                break;

            case 0:
                printf("Encerrando...\n");
                break;

            default:
                printf("Opcao invalida!\n");
        }
    } while (opcao != 0);

    return 0;
}
